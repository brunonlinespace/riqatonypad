\pard\ql\li0\ri0\fi0\sb0\sa80\sl276\slmult1 {\plain\f0\fs40\b\cf2 RiqatonyPad Documentation}\par
\pard\ql\li0\ri0\fi0\sb0\sa240\sl276\slmult1 {\plain\f0\fs26\i A lightweight Rich Text Format (RTF) editor.}\par
\pard\ql\li0\ri0\fi0\sb0\sa100\sl276\slmult1 {\plain\f0\fs30\b\cf2 Welcome}\par
\pard\ql\li0\ri0\fi0\sb0\sa160\sl276\slmult1 {\plain\f0\fs24 RiqatonyPad is dedicated to .rtf documents. It keeps the interface focused while supporting the rich-text tools needed for everyday RTF editing, printing and portable document interchange.}\par
\pard\ql\li0\ri0\fi0\sb0\sa100\sl276\slmult1 {\plain\f0\fs30\b\cf2 Getting started}\par
\pard\ql\li720\fi-360\sb0\sa60\sl276\slmult1 {\plain\f0\fs24 \u8226?\tab Create a new RTF document with File > New.}\par
\pard\ql\li720\fi-360\sb0\sa60\sl276\slmult1 {\plain\f0\fs24 \u8226?\tab Open an existing .rtf file with File > Open.}\par
\pard\ql\li720\fi-360\sb0\sa60\sl276\slmult1 {\plain\f0\fs24 \u8226?\tab Use Save or Save As to write standards-based RTF.}\par
\pard\ql\li720\fi-360\sb0\sa60\sl276\slmult1 {\plain\f0\fs24 \u8226?\tab If the backing file is deleted or renamed away externally, RiqatonyPad keeps the live document open and offers Save Version As, Recreate Original, Close Without Saving or Cancel before the live copy can be discarded.}\par
\pard\ql\li720\fi-360\sb0\sa60\sl276\slmult1 {\plain\f0\fs24 \u8226?\tab Use Locked Mode when you want to inspect a document without editing it.}\par
\pard\ql\li0\ri0\fi0\sb100\sa100\sl276\slmult1 {\plain\f0\fs30\b\cf2 Formatting}\par
\pard\ql\li720\fi-360\sb0\sa60\sl276\slmult1 {\plain\f0\fs24 \u8226?\tab Fonts, sizes, bold, italic, underline, strikeout, superscript and subscript.}\par
\pard\ql\li720\fi-360\sb0\sa60\sl276\slmult1 {\plain\f0\fs24 \u8226?\tab Text colour and highlighting.}\par
\pard\ql\li720\fi-360\sb0\sa60\sl276\slmult1 {\plain\f0\fs24 \u8226?\tab Paragraph styles, alignment, indents, spacing and line spacing.}\par
\pard\ql\li720\fi-360\sb0\sa60\sl276\slmult1 {\plain\f0\fs24 \u8226?\tab Bulleted lists.}\par
\pard\ql\li720\fi-360\sb0\sa60\sl276\slmult1 {\plain\f0\fs24 \u8226?\tab Simple tables, hyperlinks, images, symbols and horizontal rules.}\par
\pard\ql\li0\ri0\fi0\sb100\sa100\sl276\slmult1 {\plain\f0\fs30\b\cf2 New document defaults}\par
\pard\ql\li0\ri0\fi0\sb0\sa180\sl276\slmult1 {\plain\f0\fs24 Brand-new documents use the saved font family, size, style, line spacing and alignment exactly. The factory baseline is Sans Serif, 12 pt, Normal, 1.15 line spacing and Left. View > Editor Miscellaneous > New Document Defaults changes future new documents without reformatting the open file.}\par
\pard\ql\li0\ri0\fi0\sb0\sa100\sl276\slmult1 {\plain\f0\fs30\b\cf2 Editor canvas and themes}\par
\pard\ql\li0\ri0\fi0\sb0\sa180\sl276\slmult1 {\plain\f0\fs24 Dark Editor changes only the document canvas. App Theme controls the application chrome and lets you choose Light, Dark or System together with Riqa Icons Harmony, Riqa Icons Humility or Riqa Icons Heritage.}\par
\pard\ql\li0\ri0\fi0\sb0\sa100\sl276\slmult1 {\plain\f0\fs30\b\cf2 Ribbon and Retro}\par
\pard\ql\li0\ri0\fi0\sb0\sa180\sl276\slmult1 {\plain\f0\fs24 Ribbon is the default interface. Retro uses the same shared command registry in one horizontally scrollable 52 px row. Use the mouse wheel or one-finger drag when it overflows; there is no toolbar overflow arrow. Use View > Editor Toolbar to switch interfaces and Customise Retro Bar for the full applicable command and selector inventory.}\par
\pard\ql\li0\ri0\fi0\sb0\sa100\sl276\slmult1 {\plain\f0\fs30\b\cf2 Keyboard Shortcuts}\par
\pard\ql\li0\ri0\fi0\sb0\sa180\sl276\slmult1 {\plain\f0\fs24 Help > Keyboard Shortcuts shows the live QAction inventory. Search matches command names and shortcut tokens, including reordered modifiers, optional plus signs and Ctrl, Control or Ctl aliases; use the Menu filter to narrow results.}\par
\pard\ql\li0\ri0\fi0\sb0\sa100\sl276\slmult1 {\plain\f0\fs30\b\cf2 RTF fidelity}\par
\pard\ql\li0\ri0\fi0\sb0\sa180\sl276\slmult1 {\plain\f0\fs24 RiqatonyPad writes standards-based RTF for its supported subset. Bullet lists use standard RTF list tables so external readers can recognise them as real lists. Imported standard decimal lists may be preserved for interoperability, but RiqatonyPad does not provide a Numbered List command. Unsupported constructs are warned before a destructive rewrite.}\par
\pard\ql\li0\ri0\fi0\sb0\sa100\sl276\slmult1 {\plain\f0\fs30\b\cf2 Printing and PDF}\par
\pard\ql\li0\ri0\fi0\sb0\sa180\sl276\slmult1 {\plain\f0\fs24 Print and Export PDF use the same paginated QTextDocument rendering path. Page Setup controls document print headers and footers.}\par
\pard\ql\li0\ri0\fi0\sb0\sa100\sl276\slmult1 {\plain\f0\fs30\b\cf2 Useful shortcuts}\par
\pard\ql\li0\ri0\fi0\sb0\sa40\sl276\slmult1 {\plain\f1\fs24 Ctrl+N    New document}\par
\pard\ql\li0\ri0\fi0\sb0\sa40\sl276\slmult1 {\plain\f1\fs24 Ctrl+O    Open RTF}\par
\pard\ql\li0\ri0\fi0\sb0\sa40\sl276\slmult1 {\plain\f1\fs24 Ctrl+S    Save}\par
\pard\ql\li0\ri0\fi0\sb0\sa40\sl276\slmult1 {\plain\f1\fs24 Ctrl+F    Find}\par
\pard\ql\li0\ri0\fi0\sb0\sa40\sl276\slmult1 {\plain\f1\fs24 Ctrl+H    Find and Replace}\par
\pard\ql\li0\ri0\fi0\sb0\sa40\sl276\slmult1 {\plain\f1\fs24 Ctrl+Shift+L    Bullet List}\par
\pard\ql\li0\ri0\fi0\sb0\sa40\sl276\slmult1 {\plain\f1\fs24 Ctrl+L    Align Left}\par
\pard\ql\li0\ri0\fi0\sb0\sa40\sl276\slmult1 {\plain\f1\fs24 Ctrl+E    Align Centre}\par
\pard\ql\li0\ri0\fi0\sb0\sa40\sl276\slmult1 {\plain\f1\fs24 Ctrl+R    Align Right}\par
\pard\ql\li0\ri0\fi0\sb0\sa40\sl276\slmult1 {\plain\f1\fs24 Ctrl+J    Justify}\par
\pard\ql\li0\ri0\fi0\sb0\sa160\sl276\slmult1 {\plain\f1\fs24 F1        Documentation}\par
\pard\ql\li0\ri0\fi0\sb0\sa100\sl276\slmult1 {\plain\f0\fs30\b\cf2 Project}\par
\pard\ql\li0\ri0\fi0\sb0\sa120\sl276\slmult1 {\plain\f0\fs24 RiqatonyPad is built on Python, PyQt6, Nuxpad 2, PyWordpad and Microsoft WordPad-inspired document features. PyWordpad is acknowledged as a behavioural reference; this statement does not make a licensing claim about PyWordpad.}\par
